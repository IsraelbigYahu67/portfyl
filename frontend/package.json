{
  "name": "portfyl",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "measure:bundle": "node scripts/measure-initial-bundle.mjs dist",
    "audit:readability": "node scripts/audit-readability.mjs src",
    "dev": "vite --mode edition-local",
    "build": "vite build --mode edition-local",
    "build:cloud": "vite build --mode edition-cloud && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run --mode edition-local",
    "test:cloud": "vitest run --mode edition-cloud",
    "test:watch": "vitest --mode edition-local"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@sentry/react": "^10.75.0",
    "@tanstack/react-query": "^5.62.7",
    "axios": "^1.20.0",
    "firebase": "^12.18.0",
    "lucide-react": "^0.468.0",
    "posthog-js": "^1.434.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.5",
    "react-grid-layout": "^2.2.3",
    "react-router-dom": "^7.18.3",
    "recharts": "^2.14.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
