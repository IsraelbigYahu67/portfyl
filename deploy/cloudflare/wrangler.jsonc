{
  "name": "portfyl-beta-proxy",
  "main": "portfyl-beta-proxy.js",
  "compatibility_date": "2026-09-11",
  "account_id": "3916fe593a206440d1e59cc339abff7f",
  "workers_dev": false,
  "preview_urls": false,
  "secrets": {
    "required": ["PORTFYL_EDGE_TOKEN"]
  },
  "routes": [
    {
      "pattern": "app.portfyl.com/*",
      "zone_id": "229f36f4679011c026f59c805aea1c12"
    },
    {
      "pattern": "portfyl.com/*",
      "zone_id": "229f36f4679011c026f59c805aea1c12"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
