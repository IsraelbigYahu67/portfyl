[
  {
    "name": "delete-old-images",
    "action": { "type": "Delete" },
    "condition": {
      "tagState": "ANY",
      "olderThan": "604800s"
    }
  },
  {
    "name": "keep-recent-images",
    "action": { "type": "Keep" },
    "mostRecentVersions": {
      "keepCount": 5
    }
  },
  {
    "name": "keep-production-and-rollback",
    "action": { "type": "Keep" },
    "condition": {
      "tagState": "TAGGED",
      "tagPrefixes": ["production", "rollback"]
    }
  }
]
